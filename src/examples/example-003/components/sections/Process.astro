---
import { STEPS } from "../../data";
---
<section class="process invert" id="process" data-nav-dark>
  <div class="container">
    <div class="label-row">
      <p class="label">[ 04 ] Process</p>
      <p class="label muted">Twelve to thirty months, door to door</p>
    </div>
    <div class="cols body">
      <div class="side">
        <h2 data-copy="lines">How a house <em>begins</em></h2>
      </div>
      <ol class="steps">
        {STEPS.map((s) => (
          <li class="step">
            <p class="label muted num reveal-up">{s.n}</p>
            <h3 data-copy="lines">{s.title}</h3>
            <p class="reveal-up">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .process { padding-block: 6rem 8rem; }
  .body { padding-top: 3rem; align-items: start; }
  .side { grid-column: 1 / span 5; position: sticky; top: 6rem; }
  .steps { grid-column: 7 / -1; display: grid; gap: 4.5rem; }
  .step { display: grid; grid-template-columns: 4rem 1fr; column-gap: var(--gutter); row-gap: 1rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .step h3, .step p:last-child { grid-column: 2; }
  .step p:last-child { max-width: 38ch; color: var(--muted); }
  @media (max-width: 1000px) {
    .side { position: static; margin-bottom: 3rem; }
    .step { grid-template-columns: 2.5rem 1fr; }
  }
</style>
