---
const cols = [
  { h: "Studio", items: ["Jl. Tirtodipuran 41", "Yogyakarta 55143", "Indonesia"] },
  { h: "Contact", items: ["studio@lengkung.example", "+62 274 000 041"] },
  { h: "Elsewhere", items: ["Instagram", "Are.na", "LinkedIn"] },
];
---
<footer class="footer" id="contact">
  <div class="container">
    <div class="cta">
      <p class="label muted">[ 05 ] Begin</p>
      <h2 data-copy="lines">Start at<br />the <em>threshold</em></h2>
      <div class="cta-row reveal-up">
        <p>Tell us about the land, the people who will live there and the door you imagine. We reply within a week and visit sites across Central Java and DIY.</p>
        <a href="mailto:studio@lengkung.example" class="btn">Book a site visit <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="cols info">
      {cols.map((c) => (
        <div class="col">
          <p class="label muted">{c.h}</p>
          <ul>{c.items.map((it) => <li>{it}</li>)}</ul>
        </div>
      ))}
      <div class="col clock">
        <p class="label muted">Yogyakarta</p>
        <p class="time tnum" data-clock="Asia/Jakarta">--:--</p>
      </div>
    </div>

    <p class="wordmark" aria-hidden="true" data-wordmark>Lengkung</p>
    <div class="legal">
      <p class="label muted">© 2026 Lengkung — a fictional studio</p>
      <a href="#top" class="label link-line">Back to the door ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer { padding-top: 7rem; overflow: clip; }
  .cta { display: grid; gap: 2rem; padding-bottom: 6rem; }
  .cta-row { display: flex; justify-content: space-between; align-items: end; gap: 2rem; }
  .cta-row p { max-width: 40ch; }
  .info { padding-block: 2rem; border-top: 1px solid var(--line); row-gap: 2rem; }
  .col { grid-column: span 3; display: grid; align-content: start; gap: 0.7rem; }
  .col ul { display: grid; gap: 0.2rem; font-weight: 300; }
  .time { font-family: var(--ff-display); font-size: 3.5rem; line-height: 0.9; letter-spacing: -0.03em; }
  .wordmark {
    font-family: var(--ff-display); font-weight: 500; font-size: 23.5vw; line-height: 0.8; letter-spacing: -0.05em;
    margin-top: 3rem; margin-left: -0.04em; white-space: nowrap; overflow: clip; padding-bottom: 0.12em;
  }
  .legal { display: flex; justify-content: space-between; padding-block: 1rem 3rem; border-top: 1px solid var(--line); }
  @media (max-width: 1000px) {
    .cta-row { flex-direction: column; align-items: start; }
    .col { grid-column: span 6 !important; }
  }
</style>

<script>
  import { gsap, SplitText } from "../../scripts/lenis-gsap";
  import { onPage } from "../../scripts/lifecycle";
  // Wordmark letters rise one by one from behind the baseline.
  onPage<HTMLElement>("[data-wordmark]", (root, { ctx, reduced }) => {
    if (reduced) return;
    void document.fonts.ready.then(() => {
      ctx.add(() => {
        const split = SplitText.create(root, { type: "chars", mask: "chars", charsClass: "char", aria: "none" });
        gsap.from(split.chars, {
          yPercent: 110, duration: 1.4, ease: "hop", stagger: 0.05,
          scrollTrigger: { trigger: root, start: "top 92%", once: true },
        });
      });
    });
  });
</script>
