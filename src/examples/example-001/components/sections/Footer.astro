---
const cols = [
  { h: "Product", links: ["Roast profiles", "Green inventory", "Production planner", "Cupping & QC", "Changelog"] },
  { h: "Roasters", links: ["Diedrich", "Giesen", "Probat", "Loring", "Artisan import"] },
  { h: "Company", links: ["About", "Careers", "Press", "Contact"] },
];
---
<footer class="footer invert" data-nav-dark data-footer>
  <div class="container">
    <div class="footer-top">
      <div class="footer-intro">
        <p class="lg">Software for people who roast.</p>
        <p class="mono clock">Bandung <span data-clock class="tnum">--:--:--</span> WIB</p>
      </div>
      {cols.map((c) => (
        <nav aria-label={c.h} class="footer-col">
          <p class="mono">{c.h}</p>
          <ul>{c.links.map((l) => <li><a href="#" class="flink">{l}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <p class="wordmark" aria-hidden="true">Firstcrack</p>
    <div class="footer-bottom mono">
      <span>© 2026 Firstcrack Labs</span>
      <span>hello@firstcrack.app</span>
      <a href="#top" class="flink">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: 5rem 1.5rem; overflow: clip; border-top: 1px solid color-mix(in oklab, var(--paper) 18%, transparent); }
  .footer-top { display: grid; grid-template-columns: 2fr repeat(3, 1fr); gap: var(--gutter); }
  .footer-intro { display: flex; flex-direction: column; gap: 1.5rem; }
  .footer-intro .lg { max-width: 16ch; }
  .footer-col { display: flex; flex-direction: column; gap: 1rem; }
  .footer-col ul { display: grid; gap: 0.5rem; }
  .flink { position: relative; }
  .flink::after { content: ""; position: absolute; left: 0; right: 0; bottom: -2px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform 400ms var(--ease-out); }
  .flink:hover::after { transform: scaleX(1); transform-origin: left; }
  .wordmark {
    font-family: var(--ff-display); font-weight: 800; letter-spacing: -0.055em; line-height: 0.78;
    font-size: 23.2vw; margin: 4rem 0 1.5rem -0.04em; white-space: nowrap;
  }
  .footer-bottom { display: flex; justify-content: space-between; gap: 1rem; }
  @media (max-width: 1000px) {
    .footer-top { grid-template-columns: 1fr 1fr; row-gap: 2.5rem; }
    .footer-intro { grid-column: 1 / -1; }
    .footer-bottom { flex-direction: column; }
  }
</style>

<script>
  import { onPage } from "../../scripts/lifecycle.js";
  onPage("[data-footer]", (root) => {
    const el = root.querySelector("[data-clock]");
    const fmt = new Intl.DateTimeFormat("en-GB", { timeZone: "Asia/Jakarta", hour: "2-digit", minute: "2-digit", second: "2-digit" });
    const tick = () => { el.textContent = fmt.format(new Date()); };
    tick();
    const id = setInterval(tick, 1000);
    return () => clearInterval(id);
  });
</script>
